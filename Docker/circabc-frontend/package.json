{
  "name": "circabc",
  "version": "4.1.4",
  "license": "EUPL-1.1",
  "engines": {
    "node": ">=20.0.0",
    "yarn": ">=1.21.1 <2"
  },
  "angular-cli": {},
  "scripts": {
    "ng": "ng",
    "ng-version": "ng version",
    "ng-update": "ng update @angular/core @angular/cli --next --force  --allow-dirty",
    "ng-update-cli": "ng update @angular/cli --allow-dirty",
    "ng-update-core": "ng update @angular/core --allow-dirty",
    "ng-update-help": "ng update --help",
    "start": "ng serve -o",
    "build": "ng build",
    "build-prod-profile": "ng build --configuration production",
    "build-prod": "ng build --configuration production",
    "dcp-npx": "npx jscpd  src --format \"typescript,markup,scss\"  --ignore \"src/app/core/generated/**/*.ts\" --min-lines 30 --max-lines 2000 ",
    "dcp": "jscpd  src --format \"typescript,markup,scss\"  --ignore \"src/app/core/generated/**/*.ts\" --min-lines 30 --max-lines 2000 ",
    "gulp-format": "gulp  prettier",
    "gulp-format-scss": "gulp  format:scss ",
    "format-check": "prettier --single-quote --list-different --html-whitespace-sensitivity strict \"src/**/*.html\" \"src/**/*.ts\"  \"!src/app/core/generated/**/*.ts\" \"!src/app/app-info.ts\" ",
    "format-fix": "prettier --write --single-quote --list-different --html-whitespace-sensitivity strict \"src/**/*.html\" \"src/**/*.ts\"  \"!src/app/core/generated/**/*.ts\" \"!src/app/app-info.ts\" ",
    "format-fix-gen": "prettier --write --single-quote --list-different \"src/app/core/generated/**/*.ts\" ",
    "format-check-crlf": "prettier --single-quote --list-different  \"src/**/*.ts\"  \"!src/app/core/generated/**/*.ts\" \"!src/app/app-info.ts\" --end-of-line=crlf ",
    "format-check-scss": "prettier --single-quote --list-different  \"src/**/*.scss\" ",
    "prettier": "prettier --version",
    "lf-gen": "crlf --set=LF \"src/app/core/generated/**/*.ts",
    "lf-all": "crlf --set=LF \"src/**/*.ts",
    "image-compress": "gulp imagemin",
    "unittest": "ng test",
    "unit-tests": "ng test --source-map=true",
    "test-headless": "ng test --browsers ChromeHeadless --watch=false",
    "tsc-version": "tsc  --version",
    "tsc": "tsc  --project src/tsconfig.app.json --pretty",
    "tsc-watch": "tsc  --project src/tsconfig.app.json --pretty --watch",
    "tsc-heap": "node --max-old-space-size=8192 ./node_modules/typescript/lib/tsc.js  --project src/tsconfig.app.json --pretty",
    "stylelint": "node ./node_modules/stylelint/bin/stylelint.js \"src/**/*.scss\"",
    "stylelint-html": "node ./node_modules/stylelint/bin/stylelint.js \"src/**/*.html\" ",
    "stylelint-fix": "node ./node_modules/stylelint/bin/stylelint.js \"src/**/*.scss\" --fix",
    "stylelint-html-fix": "node ./node_modules/stylelint/bin/stylelint.js \"src/**/*.html\" --fix ",
    "lint": "ng lint circabc",
    "lint-force": "ng lint circabc",
    "lint-fix": "ng lint circabc --fix",
    "e2e": "cypress open",
    "e2e-run": "cypress run",
    "e2e-tomcat": "cypress run",
    "build-stat": "ng build --configuration production --stats-json",
    "build-stat-vsm": "ng build --configuration production --source-map",
    "build-stat-heap": "npm run build-stat  --max-old-space-size=4096",
    "bundle-report": "webpack-bundle-analyzer dist/circabc/stats.json",
    "code-coverage": "ng test --watch=false --code-coverage",
    "doc-build": "./node_modules/.bin/compodoc -p tsconfig.json",
    "doc-serve": "http-serve ./documentation -p 9090",
    "doc-build-serve": "./node_modules/.bin/compodoc -p tsconfig.json -s -r 9090 -o",
    "get-build-date": "node getBuildDate.js",
    "http-serve": "http-serve ./dist/circabc -p 4200",
    "http-serve-gzip": "http-serve ./dist/circabc -p 4200 --gzip ",
    "bamboo": "npm run get-build-date && npm run tsc && npm run format-check && npm run lint && npm run stylelint && npm run build-prod ",
    "bamboo-crlf": "npm run get-build-date && npm run tsc && npm run format-check-crlf && npm run lint && npm run stylelint && npm run build-prod ",
    "build-circabc1213-atelier-dev1": "npm run get-build-date && ng build -c=circabc1213-atelier-dev1",
    "build-training": "npm run get-build-date && ng build -c=training",
    "localhost": "npm run get-build-date && ng build --configuration production -c=localhost",
    "docker": "npm run get-build-date && ng build --configuration production -c=docker && gzipper compress --verbose ./dist/circabc",
    "docker-it-nrw": "npm run get-build-date && ng build --configuration production -c=docker-it-nrw && gzipper compress --verbose ./dist/circabc",
    "build-tomcat": "npm run get-build-date && ng build -c=tomcat",
    "tomcat": "npm run get-build-date && ng serve -c=tomcat -o",
    "test": "npm run get-build-date && ng build --configuration production -c=test",
    "stress": "npm run get-build-date && ng build -c=stress",
    "development": "npm run get-build-date && ng build --configuration production -c=development",
    "testenv": "npm run get-build-date && ng build --configuration production -c=test",
    "acceptance": "npm run get-build-date && ng build --configuration production -c=acceptance",
    "production": "npm run get-build-date && ng build --configuration production -c=production",
    "build-scircabc-acc": "npm run get-build-date && ng build --configuration production -c=scircabc-acc",
    "build-scircabc-prod": "npm run get-build-date && ng build --configuration production -c=scircabc-prod",
    "build-shs-acceptance": "npm run get-build-date && ng build --configuration production -c=shs-acceptance",
    "build-shs-prod": "npm run get-build-date && ng build --configuration production -c=shs-prod",
    "build-enisa-acceptance": "npm run get-build-date && ng build --configuration production -c=enisa-acceptance",
    "build-enisa-prod": "npm run get-build-date && ng build --configuration production -c=enisa-prod",
    "ncu": "npx npm-check-updates",
    "ncu-u": "npx npm-check-updates -u",
    "browserslist": "npx browserslist",
    "check": "npx npm-check -u",
    "link-status": "npx link-status -p",
    "npx-http-serve": "npx http-serve ./dist/circabc -p 4200",
    "gen-version": "openapi-generator-cli version",
    "circabc-api": "rimraf src/app/core/generated/circabc && openapi-generator-cli generate -i apis/openapi.yaml -g typescript-angular -o src/app/core/generated/circabc --additional-properties ngVersion=18.0.0 && npm run format-fix-gen",
    "ares-bridge-api": "rimraf src/app/core/generated/ares-bridge && openapi-generator-cli generate -i apis/ares-bridge.yaml -g typescript-angular -o src/app/core/generated/ares-bridge --additional-properties ngVersion=18.0.0 && npm run format-fix-gen",
    "tomcat-prod-it-nrw": "npm run get-build-date && ng build --configuration production -c=tomcat-prod-it-nrw && gzipper compress --verbose ./dist/circabc"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~18.2.0",
    "@angular/cdk": "~18.2.0",
    "@angular/common": "~18.2.0",
    "@angular/compiler": "~18.2.0",
    "@angular/core": "~18.2.0",
    "@angular/forms": "~18.2.0",
    "@angular/platform-browser": "~18.2.0",
    "@angular/platform-browser-dynamic": "~18.2.0",
    "@angular/router": "~18.2.0",
    "@angular/service-worker": "~18.2.0",
    "@ngx-translate/core": "~16.0.0",
    "@ngx-translate/http-loader": "~16.0.0",
    "file-saver": "2.0.5",
    "font-awesome": "4.7.0",
    "ngx-clipboard": "~16.0.0",
    "ngx-cookie-service": "~18.0.0",
    "ngx-extended-pdf-viewer": "~21.0.0",
    "primeicons": "~7.0.0",
    "primeng": "~17.18.0",
    "quill": "~2.0.0",
    "rxjs": "~7.8.0",
    "tslib": "~2.6.0",
    "ubuntu-fontface": "0.1.13",
    "zone.js": "~0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~18.2.0",
    "@angular/cli": "~18.2.0",
    "@angular/compiler-cli": "~18.2.0",
    "@angular-eslint/builder": "~18.3.0",
    "@angular-eslint/eslint-plugin": "~18.3.0",
    "@angular-eslint/eslint-plugin-template": "~18.3.0",
    "@angular-eslint/schematics": "~18.3.0",
    "@angular-eslint/template-parser": "~18.3.0",
    "@compodoc/compodoc": "~1.1.25",
    "@openapitools/openapi-generator-cli": "~2.13.0",
    "@types/file-saver": "~2.0.7",
    "@types/jasmine": "~5.1.0",
    "@types/node": "~20.14.0",
    "@typescript-eslint/eslint-plugin": "~7.18.0",
    "@typescript-eslint/parser": "~7.18.0",
    "crlf": "1.1.1",
    "cypress": "~13.13.0",
    "eslint": "~8.57.0",
    "gulp": "~4.0.2",
    "gulp-imagemin": "~7.1.0",
    "gulp-prettier": "~6.0.0",
    "gzipper": "~7.2.0",
    "jasmine-core": "~5.1.0",
    "jasmine-spec-reporter": "~7.0.0",
    "jscpd": "~3.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-cli": "~2.0.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "~3.3.0",
    "rimraf": "~5.0.0",
    "stylelint": "~16.6.0",
    "stylelint-config-standard": "~36.0.0",
    "stylelint-config-standard-scss": "~13.1.0",
    "ts-node": "~10.9.0",
    "typescript": "~5.5.0",
    "webpack-bundle-analyzer": "~4.10.0"
  }
}
